namespace GansuTechFinanceDevV1EnhanceChunk

Policy(政策): EntityType
    properties:
        description(描述): Text
        name(名称): Text
            index: Text
        issuingAgencyName(发布机构名称): Text
        policyId(政策ID): Text
            index: Text
        policyType(政策类型): Text
        publishDate(发布日期): Text
        regionId(所属区域ID): Text
        sourceUrl(来源链接): Text
        theme(主题): Text
        remark(备注): Text
    relations:
        supports(支持): FinancialProduct
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        targetsEnterprise(面向企业): Enterprise
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        targetsIndustrySegment(面向产业细分): IndustrySegment
            rule: [[
                Define (s:Policy)-[p:targetsIndustrySegment]->(o:IndustrySegment) {
                    Structure {
                        (s)-[:targetsEnterprise]->(e:Enterprise)-[:belongsToIndustry]->(o)
                    }
                    Constraint {
                    }
                }
            ]]
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        locatedIn(位于): Region
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
