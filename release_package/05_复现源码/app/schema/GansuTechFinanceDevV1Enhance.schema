namespace GansuTechFinanceDevV1Enhance

Policy(政策): EntityType
    properties:
        description(描述): Text
        name(名称): Text
            index: Text
        issuingAgencyName(发布机构名称): Text
        policyId(政策ID): Text
            index: Text
        policyType(政策类型): Text
        publishDate(发布日期): Text
        regionId(所属区域ID): Text
        sourceUrl(来源链接): Text
        theme(主题): Text
        remark(备注): Text
    relations:
        supports(支持): FinancialProduct
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        targetsEnterprise(面向企业): Enterprise
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        targetsIndustrySegment(面向产业细分): IndustrySegment
            properties:
                sourceUrl(边来源链接): Text
                creditLevel(边证据等级): Text
                evidenceRule(边证据规则): Text
                isExpanded(是否扩展): Text
                remark(边备注): Text
                secondarySourceUrl(边第二来源链接): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text
        hasCoverageRegion(形成地区覆盖): Region
            rule: [[
                Define (s:Policy)-[p:hasCoverageRegion]->(o:Region) {
                    Structure {
                        (s)-[:supports]->(fp:FinancialProduct)-[:servesEnterprise]->(e:Enterprise)-[:locatedIn]->(o)
                    }
                    Constraint {
                    }
                }
            ]]
            properties:
                relationCn(关系中文名): Text
                businessMeaning(业务含义): Text
                isInferred(是否推理关系): Text
                evidenceType(证据类型): Text
                creditLevel(证据等级): Text
                ruleName(规则名称): Text
                ruleChain(规则链路): Text
                supportPathCount(支撑路径数量): Text
                confidenceScore(置信评分): Text
                supportStrength(支撑强度): Text
                isOpportunity(是否机会关系): Text
                matchedProducts(匹配产品): Text
                matchedFeatures(匹配特征): Text
                matchedPolicies(匹配政策): Text
                sampleSupportPaths(样例支撑路径): Text
                sourceUrl(边来源链接): Text
                remark(边备注): Text
                relationLayer(边关系层): Text
                relationType(边关系类型): Text
                sourceLabel(边起点标签): Text
                targetLabel(边终点标签): Text

        hasCoverageIndustry(形成行业覆盖): IndustrySegment
            rule: [[
                Define (s:Policy)-[p:hasCoverageIndustry]->(o:IndustrySegment) {
                    Structure {
                        (s)-[:supports]->(fp:FinancialProduct)-[:servesEnterprise]->(e:Enterprise)-[:belongsToIndustry]->(o)
                    }
                    Constraint {
                    }
                }
            ]]
