# Copy to .env and set your own values locally.
GTF_NEO4J_URI=bolt://127.0.0.1:7688
GTF_NEO4J_USER=neo4j
GTF_NEO4J_PASSWORD=change-this-local-password
GTF_NEO4J_DATABASE=neo4j
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus
GTF_EMBEDDING_BACKEND=sentence_transformers
# Set this to the absolute model directory after download_models.py completes.
GTF_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
